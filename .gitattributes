# Normalize all text to LF in the repo. This project runs on Linux GitHub
# Actions runners; CRLF would break scripts/setup-remote.sh and the workflows.
* text=auto eol=lf

# Be explicit for the files that must be LF at runtime.
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
