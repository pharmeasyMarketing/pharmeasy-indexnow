# ---------------------------------------------------------------------------
# Template for local settings. Copy to `.env` and fill in.  `.env` is gitignored.
#
#   cp .env.example .env
#
# None of this is needed to RUN the automation (that happens in GitHub Actions).
# It only wires this working copy up to your office GitHub repo and holds the
# IndexNow key for local dry-runs.
# ---------------------------------------------------------------------------

# --- Office GitHub repo connection -----------------------------------------
# Where this repo lives. Use the SSH form if you have SSH keys set up, or the
# HTTPS form if you push with a personal access token (see GIT_PUSH_TOKEN).
GITHUB_REPO=git@github.com:<your-org>/pharmeasy-indexnow.git
# GITHUB_REPO=https://github.com/<your-org>/pharmeasy-indexnow.git
GITHUB_REMOTE=origin

# Commit identity for local commits (CI uses its own bot identity).
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=marketing@pharmeasy.in

# Only needed for HTTPS pushes. Create at github.com > Settings > Developer
# settings > Personal access tokens. Scopes: `repo` and `workflow`.
# Leave blank if you push over SSH.
GIT_PUSH_TOKEN=

# --- IndexNow --------------------------------------------------------------
# The key is PUBLIC by design (it is published at https://pharmeasy.in/<key>.txt
# and set as the INDEXNOW_KEY repo secret). Kept here for local --dry-run use.
INDEXNOW_KEY=
